# Harvester Web — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# docker compose will read .env automatically.

# --- Auth key for the web API (generate a strong random value) ---
WEB_AUTH_KEY=

# --- Encryption key for stored credentials (64 hex chars recommended) ---
ENCRYPTION_KEY=

# --- gpt-load push service credentials ---
GPT_LOAD_AUTH_KEY=sk-
GPT_LOAD_BASE_URL=http://192.168.1.18:43001

# --- Tavily push service credentials ---
TAVILY_PROXY_BASE_URL=
TAVILY_PROXY_AUTH_KEY=

# --- Storage paths (inside container) ---
HARVESTER_WORKSPACE=/app/data
HARVESTER_DB_PATH=/app/data/harvester.db

# --- Timezone ---
TZ=Asia/Shanghai
